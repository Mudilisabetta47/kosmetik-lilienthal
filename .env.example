# Öffentliche Basis-URL (Canonical, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://autokosmetik-lilienthal.de

# Terminanfragen per E-Mail (Resend, https://resend.com). Ohne diese Werte
# antwortet /api/anfrage mit "nicht konfiguriert" und das Formular zeigt
# den Anruf-Fallback.
RESEND_API_KEY=
REQUEST_TO_EMAIL=
REQUEST_FROM_EMAIL="autokosmetik Lilienthal <anfrage@ihre-domain.de>"

# Anzahl der Google-Bewertungen (nur eintragen, wenn korrekt!) – aktiviert AggregateRating im Markup
# und die Anzeige „… · 57 Rezensionen“
NEXT_PUBLIC_REVIEW_COUNT=
